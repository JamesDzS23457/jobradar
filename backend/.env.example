# App
APP_NAME=JobRadar
ENVIRONMENT=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database and files (relative to the backend directory)
DATABASE_URL=sqlite:///../data/jobradar.db
UPLOAD_DIR=../data/uploads
EXPORT_DIR=../data/exports

# LLM (OpenRouter free models). Add your key to backend/.env only; never paste it in chat.
# Usamos OpenRouter como única API de IA.
# Los IDs que empiezan por "nvidia/" son el namespace de modelos de NVIDIA
# dentro de OpenRouter; NO llamamos a la API directa de NVIDIA.
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Alias opcional: también puedes usar OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning:free
LLM_MODEL_QUALITY=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_FALLBACK=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=90

# Application assistant
# Auto-submit is opt-in and only runs for the allowlisted portals below.
AUTO_SUBMIT_ENABLED=false
AUTO_SUBMIT_MAX_PER_RUN=5
AUTO_SUBMIT_PORTALS=greenhouse,lever,ashby,workable,breezy,teamtailor
MANUAL_ONLY_PORTALS=linkedin,indeed,computrabajo,magneto,elempleo,glassdoor
DEFAULT_CV_SOURCE=tailored
FRESHNESS_DAYS=2

# Job sources
JSEARCH_API_KEY=
JOOBLE_API_KEY=
# Optional: public web discovery through Brave Search (free tier available).
BRAVE_SEARCH_API_KEY=

# Email alerts (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
ALERT_THRESHOLD=85
DIGEST_THRESHOLD=70
DIGEST_HOUR=8

# Scheduler
ENABLE_SCHEDULER=false
SEARCH_INTERVAL_HOURS=6
TIMEZONE=America/Bogota
