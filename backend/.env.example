# ============================================================
# JobRadar - configuración del backend
# ============================================================
# Copia este archivo a backend/.env y cambia solo lo que necesites.
# No subas backend/.env a Git ni compartas tus claves.

# ---------- Aplicación ----------
APP_NAME=JobRadar
ENVIRONMENT=development
# true = modo demo con datos de ejemplo, sin claves ni red.
# false = usa tu perfil, tu CV y vacantes reales.
DEMO_MODE=true
# Orígenes del frontend que pueden llamar a la API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Base de datos y archivos ----------
# Las rutas son relativas a la carpeta backend/.
DATABASE_URL=sqlite:///../data/jobradar.db
UPLOAD_DIR=../data/uploads
EXPORT_DIR=../data/exports

# ---------- IA: OpenRouter (única API) ----------
# Pega tu clave en backend/.env. Nunca la escribas en el chat ni la subas a Git.
# Puedes usar LLM_API_KEY o OPENROUTER_API_KEY; cualquiera de las dos funciona.
# Los IDs que empiezan por "nvidia/" son modelos de NVIDIA servidos por
# OpenRouter. NO se usa la API directa de NVIDIA ni hace falta una segunda clave.
LLM_PROVIDER=openrouter
LLM_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Modelo rápido: extraer datos del CV y analizar ofertas.
LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning:free
# Modelo de calidad: adaptar el CV y redactar respuestas.
LLM_MODEL_QUALITY=nvidia/nemotron-3-ultra-550b-a55b:free
# Modelo de respaldo si el principal falla o está limitado.
LLM_MODEL_FALLBACK=nvidia/nemotron-3.5-super-vl:free
# Tiempo máximo de espera por llamada, en segundos.
LLM_TIMEOUT_SECONDS=90

# ---------- Asistente de postulaciones ----------
# El auto-envío real se activa con el interruptor de Ajustes.
# Déjalo en false si quieres revisar cada postulación antes de enviarla.
AUTO_SUBMIT_ENABLED=false
# Número máximo de vacantes por ronda de auto-envío.
AUTO_SUBMIT_MAX_PER_RUN=5
# Portales ATS donde SÍ se permite el auto-envío.
AUTO_SUBMIT_PORTALS=greenhouse,lever,ashby,workable,breezy,teamtailor
# Portales que NUNCA se asisten ni se envían automáticamente.
MANUAL_ONLY_PORTALS=linkedin,indeed,computrabajo,magneto,elempleo,glassdoor
# CV predeterminado: tailored (adaptado ATS) u original (archivo original).
DEFAULT_CV_SOURCE=tailored
# Frescura por defecto del listado: 1 = 24 h, 2 = 48 h, 7 = 7 días.
FRESHNESS_DAYS=2

# ---------- Fuentes de vacantes (opcionales) ----------
# Lectura pública de la búsqueda de Computrabajo (sin login ni postulación automática).
COMPUTRABAJO_PUBLIC_SEARCH=true

# ---------- Búsqueda web (opcional, pero recomendada) ----------
# Proveedor: tavily (sin tarjeta) o brave (requiere tarjeta/créditos).
WEB_SEARCH_PROVIDER=tavily
# Tavily keyless funciona sin cuenta ni clave. Si consigues una clave gratis,
# pégala aquí para tener más cuota; no requiere tarjeta.
TAVILY_API_KEY=
TAVILY_KEYLESS=true
# Brave queda como alternativa opcional.
# JSearch y Jooble permiten búsquedas automáticas.
# Si los dejas vacíos, aún puedes importar vacantes manualmente por URL.
# JSearch: suscríbete a "JSearch" en RapidAPI. El plan gratuito da ~200 solicitudes/mes.
# En JobRadar cada "Buscar ahora" consume 1 solicitud (endpoint /search-v2).
JSEARCH_API_KEY=
# Consigue la clave de Colombia en https://co.jooble.org/api/about
# Jooble: el plan gratuito permite 500 solicitudes por clave EN TOTAL.
# No se reinicia cada mes. Cada "Buscar ahora" o ejecución del programador
# consume 1 solicitud. Para probar sin gastar cuota, usa "Importar por URL".
JOOBLE_API_KEY=
# Brave Search es opcional para descubrir vacantes públicas en la web.
BRAVE_SEARCH_API_KEY=

# ---------- Alertas por correo (opcional) ----------
# Para alertas reales, DEMO_MODE debe ser false. El correo de prueba funciona aun en demo.
# Para Gmail usa una contraseña de aplicación, no tu contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
ALERT_THRESHOLD=85
DIGEST_THRESHOLD=70
DIGEST_HOUR=8

# ---------- Programador de tareas (opcional) ----------
# true = busca vacantes y envía resúmenes automáticamente.
ENABLE_SCHEDULER=false
SEARCH_INTERVAL_HOURS=6
TIMEZONE=America/Bogota
