# App
APP_NAME=JobRadar
ENVIRONMENT=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database and files (relative to the backend directory)
DATABASE_URL=sqlite:///../data/jobradar.db
UPLOAD_DIR=../data/uploads
EXPORT_DIR=../data/exports

# LLM (OpenAI-compatible). Empty means heuristic fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_QUALITY=gpt-4o-mini

# Job sources
JSEARCH_API_KEY=
JOOBLE_API_KEY=
# Optional: public web discovery through Brave Search (free tier available).
BRAVE_SEARCH_API_KEY=

# Email alerts (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
ALERT_THRESHOLD=85
DIGEST_THRESHOLD=70
DIGEST_HOUR=8

# Scheduler
ENABLE_SCHEDULER=false
SEARCH_INTERVAL_HOURS=6
TIMEZONE=America/Bogota
